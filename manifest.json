{
    "manifest_version": 2,
    "name": "Del365 - Suppression données Office 365",
    "version": "1.2.0",
    "description": "Nettoie les cookies et le stockage Office 365 / Microsoft, en mode léger ou complet",
    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },
    "permissions": [
        "browsingData",
        "notifications",
        "cookies",
        "menus",
        "*://*.office365.com/*",
        "*://*.office.com/*",
        "*://*.office.net/*",
        "*://*.outlook.com/*",
        "*://*.microsoft.com/*",
        "*://*.microsoftonline.com/*",
        "*://*.cloud.microsoft/*",
        "*://*.static.microsoft/*",
        "*://*.live.com/*",
        "*://*.sharepoint.com/*",
        "*://*.office-web.sips-services.com/*",
        "*://*.koesio.com/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_action": {
        "default_icon": {
            "48": "icons/icon-48.png",
            "96": "icons/icon-96.png"
        },
        "default_title": "Del365 : nettoyage léger (clic droit : reset complet)"
    },
    "commands": {
        "delete-office365-data": {
            "suggested_key": {
                "default": "Ctrl+Shift+D",
                "mac": "Command+Shift+D"
            },
            "description": "Nettoyage léger (Outlook / M365)"
        },
        "delete-office365-data-full": {
            "suggested_key": {
                "default": "Alt+Shift+D",
                "mac": "Alt+Shift+D"
            },
            "description": "Reset complet (toute la session Microsoft)"
        }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "{a6ac1364-317e-4c41-bc6b-e7e46fde72f4}",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "update_url": "https://raw.githubusercontent.com/ljouglar/del365-ff-extension/main/updates.json"
        }
    }
}
